import math

#функция уравнения
def f(x):
    return math.acos((1-x**2)/(1+x**2)) - x

#функция монотонности
def monoton(f, a, b):
    s = (b - a)/1000
    x = a
    y = f(x)
    voz = True
    ubi = True

    for i in range(1000):
        x_next = x + s
        y_next = f(x_next)

        if y_next < y:
            voz = False
        if y_next > y:
            ubi = False

        x = x_next
        y = y_next
    if ubi or voz:
        return True
    return True

def meth_cord(f, a, b, t):
    if monoton(f, a, b):
        while True:
            x = a - f(a) * (b - a) / (f(b) - f(a)) #приближенное значение корня по формуле
            if abs(f(x)) < t:
                return x
            else:
                if f(x) * f(b)>0:
                    b = x
                else:
                    a = x
    else:
        raise ValueError("функция не монотонна")


print(meth_cord(f, 2, 3, 0.001))


